// MIKSPEC-0057.R24

library mikros.session;
using mikros.base;

protocol TextLogin {
    @1 NeedsSetup() -> (needed bool);
    @2 RunSetup(console u8, terminal base.Token) -> () error base.Status;
    @3 Login(console u8, name string<32>, password string<1024>,
             terminal base.Token) -> () error base.Status;
    @4 -> OnSessionEnded(console u8);
};
