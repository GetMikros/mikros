// MIKSPEC-0044.R15

library mikros.storage;
using mikros.base;

type BlockFlags = bits : u32 {
    READ_ONLY = 0x1;
    REMOVABLE = 0x2;
    FLUSH = 0x4;
    DISCARD = 0x8;
    FUA = 0x10;
};

type BlockInfo = struct {
    block_size u32;
    block_count u64;
    max_transfer_blocks u32;
    flags BlockFlags;
    model string<64>;
    serial string<64>;
};

protocol Block {
    @1 GetInfo() -> (info BlockInfo);
    @2 CreateBuffer(size u64) -> (buffer u32,
                                  memory handle<MemoryObject>) error base.Status;
    @3 DestroyBuffer(buffer u32);
    @4 Read(buffer u32, offset u64, block u64,
            count u32) -> () error base.Status;
    @5 Write(buffer u32, offset u64, block u64, count u32,
             fua bool) -> () error base.Status;
    @6 Flush() -> () error base.Status;
    @7 Discard(block u64, count u64) -> () error base.Status;
    @8 LockWritable() -> () error base.Status;
    @9 UnlockWritable();
};
