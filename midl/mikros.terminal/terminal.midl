// MIKSPEC-0059.R14

library mikros.terminal;
using mikros.base;

type WindowSize = struct { rows u16; columns u16; width u16; height u16; };
type Attributes = struct {
    input_flags u32; output_flags u32; control_flags u32; local_flags u32;
    control_chars array<u8, 32>; input_speed u32; output_speed u32;
};
type When = enum : u32 { NOW = 0; DRAIN = 1; FLUSH = 2; };
type Queue = bits : u32 { INPUT = 0x1; OUTPUT = 0x2; };

protocol Factory {
    @1 Open(size WindowSize) -> (master handle<Stream>,
        master_control client_end<Master>, terminal base.Token) error base.Status;
};
protocol Master {
    @1 SetWindowSize(size WindowSize) -> () error base.Status;
};
protocol Terminal {
    @1 GetAttributes(terminal base.Token) -> (attributes Attributes) error base.Status;
    @2 SetAttributes(terminal base.Token, attributes Attributes, when When)
        -> () error base.Status;
    @3 GetWindowSize(terminal base.Token) -> (size WindowSize) error base.Status;
    @4 SetWindowSize(terminal base.Token, size WindowSize) -> () error base.Status;
    @5 GetForeground(terminal base.Token) -> (pgid u32) error base.Status;
    @6 SetForeground(terminal base.Token, pgid u32) -> () error base.Status;
    @7 MakeControlling(terminal base.Token) -> () error base.Status;
    @8 Drain(terminal base.Token) -> () error base.Status;
    @9 Flush(terminal base.Token, queues Queue) -> () error base.Status;
    @10 SendBreak(terminal base.Token) -> () error base.Status;
    @11 Read(terminal base.Token, count u32, deadline base.MonotonicTime)
        -> (data vector<u8, 32768>) error base.Status;
    @12 Write(terminal base.Token, data vector<u8, 32768>,
        deadline base.MonotonicTime) -> (written u32) error base.Status;
    @13 GetReadiness(terminal base.Token)
        -> (event handle<Event, WAIT | INSPECT | TRANSFER>) error base.Status;
    @14 GetNumber(terminal base.Token) -> (number u32) error base.Status;
};
