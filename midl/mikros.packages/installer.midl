// MIKSPEC-0101.R58

library mikros.packages;
using mikros.base;
using mikros.fs;

type PackageInfo = struct {
    id string<128>;
    kind string<16>;
    version string<64>;
    name string<128>;
    global bool;
    owner string<128>;
};

type PackageService = struct {
    name string<255>;
    app_id string<128>;
};

protocol Installer {
    @1 Inspect(package client_end<mikros.fs.Node>)
        -> (manifest vector<u8, 32768>) error base.Status;
    @2 Install(package client_end<mikros.fs.Node>,
               components vector<string<255>, 32>, dependency bool,
               dev bool, commands vector<string<255>, 32>)
        -> () error base.Status;
    @3 Remove(id string<128>, global bool, keep_data bool)
        -> () error base.Status;
    @4 List(after string<128>) -> (packages vector<PackageInfo, 64>)
        error base.Status;
    @5 CreatePublic() -> () error base.Status;
    @6 CommandOwner(name string<255>, user u32) -> (id string<128>)
        error base.Status;
    @7 Commands(server server_end<mikros.fs.Node>) -> () error base.Status;
    @8 Open(package client_end<mikros.fs.Node>,
            server server_end<mikros.fs.Node>)
        -> (manifest vector<u8, 32768>) error base.Status;
    @9 OpenPublic(id string<128>, server server_end<mikros.fs.Node>)
        -> () error base.Status;
    @10 Services(after string<255>)
        -> (services vector<PackageService, 64>) error base.Status;
    @11 ServiceManifest(name string<255>)
        -> (manifest vector<u8, 16384>) error base.Status;
};
