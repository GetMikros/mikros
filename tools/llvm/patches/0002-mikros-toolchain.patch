+#ifndef LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_MIKROS_H
+#define LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_MIKROS_H
+
+#include "Gnu.h"
+#include "clang/Basic/LangOptions.h"
+#include "clang/Driver/Tool.h"
+#include "clang/Driver/ToolChain.h"
+
+namespace clang {
+namespace driver {
+namespace tools {
+namespace mikros {
+
+class LLVM_LIBRARY_VISIBILITY Linker final : public Tool {
+public:
+  Linker(const ToolChain &TC) : Tool("mikros::Linker", "ld.lld", TC) {}
+
+  bool hasIntegratedCPP() const override { return false; }
+  bool isLinkJob() const override { return true; }
+
+  void ConstructJob(Compilation &C, const JobAction &JA,
+                    const InputInfo &Output, const InputInfoList &Inputs,
+                    const llvm::opt::ArgList &TCArgs,
+                    const char *LinkingOutput) const override;
+};
+
+} // end namespace mikros
+} // end namespace tools
+
+namespace toolchains {
+
+/// Mikros. The sysroot has the layout of /usr: headers in include/, and
+/// libraries, with the suffixes .dlib and .slib, in lib/.
+class LLVM_LIBRARY_VISIBILITY Mikros final : public Generic_ELF {
+public:
+  Mikros(const Driver &D, const llvm::Triple &Triple,
+         const llvm::opt::ArgList &Args);
+
+  void
+  AddClangSystemIncludeArgs(const llvm::opt::ArgList &DriverArgs,
+                            llvm::opt::ArgStringList &CC1Args) const override;
+
+  RuntimeLibType GetDefaultRuntimeLibType() const override {
+    return ToolChain::RLT_CompilerRT;
+  }
+
+  CXXStdlibType GetDefaultCXXStdlibType() const override {
+    return ToolChain::CST_Libcxx;
+  }
+
+  const char *getDefaultLinker() const override { return "ld.lld"; }
+
+  std::string getDynamicLinker(const llvm::opt::ArgList &) const override {
+    return "/usr/lib/ld-mikros.dlib";
+  }
+
+  bool HasNativeLLVMSupport() const override { return true; }
+  bool isPICDefault() const override { return true; }
+  bool isPIEDefault(const llvm::opt::ArgList &) const override { return true; }
+  bool IsMathErrnoDefault() const override { return false; }
+
+  UnwindTableLevel
+  getDefaultUnwindTableLevel(const llvm::opt::ArgList &Args) const override {
+    return UnwindTableLevel::Asynchronous;
+  }
+
+  LangOptions::StackProtectorMode
+  GetDefaultStackProtectorLevel(bool KernelOrKext) const override {
+    return LangOptions::SSPStrong;
+  }
+
+  /// The path of the library that `-l<Name>` names: lib<Name>.dlib, or
+  /// lib<Name>.slib for a static link or when there is no .dlib, in the
+  /// directories of `-L` and then the toolchain's. Empty when there is
+  /// neither.
+  std::string findLibrary(const llvm::opt::ArgList &Args, llvm::StringRef Name,
+                          bool Static) const;
+
+protected:
+  Tool *buildLinker() const override;
+};
+
+} // end namespace toolchains
+} // end namespace driver
+} // end namespace clang
+
+#endif // LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_MIKROS_H
