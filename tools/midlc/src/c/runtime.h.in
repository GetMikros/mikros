/* What the C bindings that midlc generates share: their statuses, the
 * arena that calls take their messages and decoded values from, and the
 * encoder and decoder of messages, which check what they read as the
 * Rust bindings do. Generated by midlc. Do not edit. */

#ifndef MIKROS_MIDL_RUNTIME_H
#define MIKROS_MIDL_RUNTIME_H

#include <mikros/syscalls.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <string.h>

#ifdef __cplusplus
extern "C" {
#endif

/* The status of a call: MIKROS_MIDL_OK; MIKROS_MIDL_ERROR when the
 * method returned its error, which the call stores in its `error`
 * argument; a status of the bindings below; or a kernel status. */
typedef int32_t mikros_midl_status_t;

#define MIKROS_MIDL_OK 0
#define MIKROS_MIDL_ERROR 1
/* A received message was not valid. The call closed the channel. */
#define MIKROS_MIDL_INVALID (-1000)
/* A value to send does not fit its type, such as a string that is too
 * long, or the message does not fit a channel message. */
#define MIKROS_MIDL_TOO_LONG (-1001)
/* A value to send is an unknown member of a flexible union. */
#define MIKROS_MIDL_UNKNOWN_MEMBER (-1002)
/* The server does not implement the method. */
#define MIKROS_MIDL_UNKNOWN_METHOD (-1003)
/* The channel's peer closed it. */
#define MIKROS_MIDL_CLOSED (-1004)
/* The arena has no room for the message or the decoded values. */
#define MIKROS_MIDL_NO_ROOM (-1005)

#define MIKROS_MIDL_HEADER_SIZE 16u
#define MIKROS_MIDL_MESSAGE_BYTES 65536u
#define MIKROS_MIDL_MESSAGE_HANDLES 64u
#define MIKROS_MIDL_FLAG_UNKNOWN_METHOD 1u
#define MIKROS_MIDL_FLAG_FLEXIBLE 2u
/* The kernel statuses and signals the bindings tell apart. */
#define MIKROS_MIDL_KERNEL_INVALID_ARGS (-10)
#define MIKROS_MIDL_KERNEL_ACCESS_DENIED (-13)
#define MIKROS_MIDL_KERNEL_SHOULD_WAIT (-22)
#define MIKROS_MIDL_KERNEL_PEER_CLOSED (-24)
#define MIKROS_MIDL_SIGNAL_READABLE (1u << 0)
#define MIKROS_MIDL_SIGNAL_PEER_CLOSED (1u << 2)

/* The room a call takes from its arena besides its decoded reply: the
 * request and the reply with their handles. */
#define MIKROS_MIDL_CALL_ROOM                                                  \
    (2u * MIKROS_MIDL_MESSAGE_BYTES + 2u * 4u * MIKROS_MIDL_MESSAGE_HANDLES + 32u)

/* A string: `size` bytes of UTF-8 at `data`, with a NUL after them in
 * decoded values. `data` is NULL when an optional string is absent. */
typedef struct {
    const char *data;
    uint64_t size;
} mikros_midl_string_t;

/* A vector: `count` elements at `data`, of the element type that its
 * field names. `data` is NULL when an optional vector is absent. */
typedef struct {
    const void *data;
    uint64_t count;
} mikros_midl_vector_t;

/* Memory that calls take their messages and decoded values from, in
 * order. The caller empties it with mikros_midl_arena_reset once it no
 * longer needs what calls decoded into it. */
typedef struct {
    uint8_t *base;
    size_t size;
    size_t used;
} mikros_midl_arena_t;

static inline void mikros_midl_arena_init(mikros_midl_arena_t *arena, void *base, size_t size)
{
    arena->base = (uint8_t *)base;
    arena->size = size;
    arena->used = 0;
}

static inline void mikros_midl_arena_reset(mikros_midl_arena_t *arena)
{
    arena->used = 0;
}

/* `size` bytes of the arena, aligned to 8, or NULL when it has no room. */
static inline void *mikros_midl_alloc(mikros_midl_arena_t *arena, size_t size)
{
    size_t at = (arena->used + 7u) & ~(size_t)7u;
    if (at > arena->size || size > arena->size - at)
        return NULL;
    arena->used = at + size;
    return arena->base + at;
}

/* Builds one message. Once a step fails, the encoder keeps its status,
 * writes nothing more and closes the handles it is given, so that a
 * call consumes its handles also when it fails. */
typedef struct {
    uint8_t *bytes;
    uint32_t len;
    mikros_handle_t handles[MIKROS_MIDL_MESSAGE_HANDLES];
    uint32_t handle_count;
    mikros_midl_status_t status;
} mikros_midl_encoder_t;

static inline void mikros_midl_encoder_fail(mikros_midl_encoder_t *e, mikros_midl_status_t s)
{
    if (e->status == MIKROS_MIDL_OK)
        e->status = s;
}

static inline void mikros_midl_put(mikros_midl_encoder_t *e, uint32_t at, const void *data, uint32_t len)
{
    if (e->status != MIKROS_MIDL_OK)
        return;
    if (at > e->len || len > e->len - at) {
        mikros_midl_encoder_fail(e, MIKROS_MIDL_TOO_LONG);
        return;
    }
    memcpy(e->bytes + at, data, len);
}

static inline void mikros_midl_put_u8(mikros_midl_encoder_t *e, uint32_t at, uint8_t v)
{
    mikros_midl_put(e, at, &v, 1);
}

static inline void mikros_midl_put_u16(mikros_midl_encoder_t *e, uint32_t at, uint16_t v)
{
    uint8_t b[2] = {(uint8_t)v, (uint8_t)(v >> 8)};
    mikros_midl_put(e, at, b, 2);
}

static inline void mikros_midl_put_u32(mikros_midl_encoder_t *e, uint32_t at, uint32_t v)
{
    uint8_t b[4];
    for (int i = 0; i < 4; i++)
        b[i] = (uint8_t)(v >> (8 * i));
    mikros_midl_put(e, at, b, 4);
}

static inline void mikros_midl_put_u64(mikros_midl_encoder_t *e, uint32_t at, uint64_t v)
{
    uint8_t b[8];
    for (int i = 0; i < 8; i++)
        b[i] = (uint8_t)(v >> (8 * i));
    mikros_midl_put(e, at, b, 8);
}

static inline void mikros_midl_put_f32(mikros_midl_encoder_t *e, uint32_t at, float v)
{
    uint32_t bits;
    memcpy(&bits, &v, 4);
    mikros_midl_put_u32(e, at, bits);
}

static inline void mikros_midl_put_f64(mikros_midl_encoder_t *e, uint32_t at, double v)
{
    uint64_t bits;
    memcpy(&bits, &v, 8);
    mikros_midl_put_u64(e, at, bits);
}

/* Appends a zeroed object of `size` bytes, padded to 8, and returns its
 * offset; 0 once the encoder has failed. */
static inline uint32_t mikros_midl_append(mikros_midl_encoder_t *e, uint64_t size)
{
    if (e->status != MIKROS_MIDL_OK)
        return 0;
    uint64_t padded = (size + 7u) & ~(uint64_t)7u;
    if (size > MIKROS_MIDL_MESSAGE_BYTES || padded > MIKROS_MIDL_MESSAGE_BYTES - e->len) {
        mikros_midl_encoder_fail(e, MIKROS_MIDL_TOO_LONG);
        return 0;
    }
    uint32_t at = e->len;
    memset(e->bytes + at, 0, (size_t)padded);
    e->len += (uint32_t)padded;
    return at;
}

/* Starts a message in `arena` with its header and room for a body whose
 * inline part takes `body` bytes. */
static inline void mikros_midl_encoder_init(mikros_midl_encoder_t *e, mikros_midl_arena_t *arena,
                                            uint32_t txid, uint32_t ordinal, uint16_t flags,
                                            uint64_t body)
{
    e->len = 0;
    e->handle_count = 0;
    e->status = MIKROS_MIDL_OK;
    e->bytes = (uint8_t *)mikros_midl_alloc(arena, MIKROS_MIDL_MESSAGE_BYTES);
    if (e->bytes == NULL) {
        e->status = MIKROS_MIDL_NO_ROOM;
        return;
    }
    mikros_midl_append(e, MIKROS_MIDL_HEADER_SIZE);
    mikros_midl_put_u32(e, 0, txid);
    mikros_midl_put_u32(e, 4, ordinal);
    mikros_midl_put_u16(e, 8, 1);
    mikros_midl_put_u16(e, 10, flags);
    mikros_midl_append(e, body);
}

/* Whether the `len` bytes at `s` are UTF-8. */
static inline bool mikros_midl_utf8(const uint8_t *s, uint64_t len)
{
    uint64_t i = 0;
    while (i < len) {
        uint8_t c = s[i];
        unsigned n;
        uint32_t cp;
        if (c < 0x80) {
            i++;
            continue;
        } else if (c >= 0xc2 && c <= 0xdf) {
            n = 1;
            cp = c & 0x1f;
        } else if (c >= 0xe0 && c <= 0xef) {
            n = 2;
            cp = c & 0x0f;
        } else if (c >= 0xf0 && c <= 0xf4) {
            n = 3;
            cp = c & 0x07;
        } else {
            return false;
        }
        if (len - i <= n)
            return false;
        for (unsigned k = 1; k <= n; k++) {
            if ((s[i + k] & 0xc0) != 0x80)
                return false;
            cp = (cp << 6) | (s[i + k] & 0x3f);
        }
        if ((n == 2 && (cp < 0x800 || (cp >= 0xd800 && cp <= 0xdfff))) ||
            (n == 3 && (cp < 0x10000 || cp > 0x10ffff)))
            return false;
        i += n + 1;
    }
    return true;
}

/* The inline part of a present string or vector of `count` elements, at
 * most `max`. */
static inline void mikros_midl_put_vector(mikros_midl_encoder_t *e, uint32_t at, uint64_t count,
                                          uint64_t max)
{
    if (count > max) {
        mikros_midl_encoder_fail(e, MIKROS_MIDL_TOO_LONG);
        return;
    }
    mikros_midl_put_u64(e, at, count);
    mikros_midl_put_u64(e, at + 8, UINT64_MAX);
}

/* A present vector of `count` bytes, at most `max`, out of line. */
static inline void mikros_midl_put_bytes(mikros_midl_encoder_t *e, uint32_t at, const void *data,
                                         uint64_t count, uint64_t max)
{
    mikros_midl_put_vector(e, at, count, max);
    uint32_t o = mikros_midl_append(e, count);
    if (count > 0)
        mikros_midl_put(e, o, data, (uint32_t)count);
}

/* The presence marker of an optional structure. */
static inline void mikros_midl_put_present(mikros_midl_encoder_t *e, uint32_t at)
{
    mikros_midl_put_u64(e, at, UINT64_MAX);
}

/* A handle, which the encoder takes: it is sent with the message, or
 * closed when the message is not sent. */
static inline void mikros_midl_put_handle(mikros_midl_encoder_t *e, uint32_t at, mikros_handle_t h)
{
    if (e->status == MIKROS_MIDL_OK && e->handle_count == MIKROS_MIDL_MESSAGE_HANDLES)
        mikros_midl_encoder_fail(e, MIKROS_MIDL_TOO_LONG);
    if (e->status != MIKROS_MIDL_OK) {
        mikros_handle_close(h);
        return;
    }
    mikros_midl_put_u32(e, at, UINT32_MAX);
    e->handles[e->handle_count++] = h;
}

/* Where an envelope's contents start, for mikros_midl_end_envelope. */
typedef struct {
    uint32_t bytes;
    uint32_t handles;
} mikros_midl_mark_t;

static inline mikros_midl_mark_t mikros_midl_begin_envelope(const mikros_midl_encoder_t *e)
{
    mikros_midl_mark_t m = {e->len, e->handle_count};
    return m;
}

/* Stores at `at` the byte and handle counts of what was added since
 * `start`. */
static inline void mikros_midl_end_envelope(mikros_midl_encoder_t *e, uint32_t at, mikros_midl_mark_t start)
{
    mikros_midl_put_u32(e, at, e->len - start.bytes);
    mikros_midl_put_u32(e, at + 4, e->handle_count - start.handles);
}

/* Closes the handles of a message that is not sent. */
static inline void mikros_midl_encoder_discard(mikros_midl_encoder_t *e)
{
    for (uint32_t i = 0; i < e->handle_count; i++)
        mikros_handle_close(e->handles[i]);
    e->handle_count = 0;
}

/* Reads and checks one message. Once a step fails, the decoder keeps
 * its status and reads zeros. */
typedef struct {
    const uint8_t *bytes;
    uint32_t len;
    uint32_t next;
    mikros_handle_t *handles;
    uint32_t handle_count;
    uint32_t next_handle;
    mikros_midl_arena_t *arena;
    mikros_midl_status_t status;
} mikros_midl_decoder_t;

static inline void mikros_midl_decoder_init(mikros_midl_decoder_t *d, const uint8_t *bytes, uint32_t len,
                                            mikros_handle_t *handles, uint32_t handle_count,
                                            mikros_midl_arena_t *arena)
{
    d->bytes = bytes;
    d->len = len;
    d->next = MIKROS_MIDL_HEADER_SIZE;
    d->handles = handles;
    d->handle_count = handle_count;
    d->next_handle = 0;
    d->arena = arena;
    d->status = MIKROS_MIDL_OK;
}

static inline void mikros_midl_decoder_fail(mikros_midl_decoder_t *d, mikros_midl_status_t s)
{
    if (d->status == MIKROS_MIDL_OK)
        d->status = s;
}

/* Fails unless the `len` bytes at `at` are in the message. */
static inline bool mikros_midl_has(mikros_midl_decoder_t *d, uint64_t at, uint64_t len)
{
    if (d->status == MIKROS_MIDL_OK && at <= d->len && len <= d->len - at)
        return true;
    mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
    return false;
}

static inline uint64_t mikros_midl_get(mikros_midl_decoder_t *d, uint64_t at, unsigned n)
{
    if (!mikros_midl_has(d, at, n))
        return 0;
    uint64_t v = 0;
    for (unsigned i = 0; i < n; i++)
        v |= (uint64_t)d->bytes[at + i] << (8 * i);
    return v;
}

static inline uint8_t mikros_midl_get_u8(mikros_midl_decoder_t *d, uint64_t at)
{
    return (uint8_t)mikros_midl_get(d, at, 1);
}

static inline uint16_t mikros_midl_get_u16(mikros_midl_decoder_t *d, uint64_t at)
{
    return (uint16_t)mikros_midl_get(d, at, 2);
}

static inline uint32_t mikros_midl_get_u32(mikros_midl_decoder_t *d, uint64_t at)
{
    return (uint32_t)mikros_midl_get(d, at, 4);
}

static inline uint64_t mikros_midl_get_u64(mikros_midl_decoder_t *d, uint64_t at)
{
    return mikros_midl_get(d, at, 8);
}

static inline float mikros_midl_get_f32(mikros_midl_decoder_t *d, uint64_t at)
{
    uint32_t bits = mikros_midl_get_u32(d, at);
    float v;
    memcpy(&v, &bits, 4);
    return v;
}

static inline double mikros_midl_get_f64(mikros_midl_decoder_t *d, uint64_t at)
{
    uint64_t bits = mikros_midl_get_u64(d, at);
    double v;
    memcpy(&v, &bits, 8);
    return v;
}

static inline bool mikros_midl_get_bool(mikros_midl_decoder_t *d, uint64_t at)
{
    uint8_t b = mikros_midl_get_u8(d, at);
    if (b > 1)
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
    return b == 1;
}

/* Fails unless the `len` bytes at `at` are zero. */
static inline void mikros_midl_zeros(mikros_midl_decoder_t *d, uint64_t at, uint64_t len)
{
    if (!mikros_midl_has(d, at, len))
        return;
    for (uint64_t i = 0; i < len; i++)
        if (d->bytes[at + i] != 0) {
            mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
            return;
        }
}

/* Claims the next out-of-line object of `size` bytes, padded to 8 with
 * zeros, and returns its offset. */
static inline uint32_t mikros_midl_claim(mikros_midl_decoder_t *d, uint64_t size)
{
    uint64_t at = d->next;
    uint64_t padded = (size + 7u) & ~(uint64_t)7u;
    if (size > MIKROS_MIDL_MESSAGE_BYTES || !mikros_midl_has(d, at, padded))
        return 0;
    mikros_midl_zeros(d, at + size, padded - size);
    d->next = (uint32_t)(at + padded);
    return (uint32_t)at;
}

/* Whether the presence marker at `at` says present. */
static inline bool mikros_midl_get_presence(mikros_midl_decoder_t *d, uint64_t at)
{
    uint64_t v = mikros_midl_get_u64(d, at);
    if (v != 0 && v != UINT64_MAX)
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
    return v == UINT64_MAX;
}

/* The element count of the string or vector at `at`, at most `max`;
 * `*present` tells whether it is there. */
static inline uint64_t mikros_midl_get_vector(mikros_midl_decoder_t *d, uint64_t at, uint64_t max,
                                              bool *present)
{
    uint64_t count = mikros_midl_get_u64(d, at);
    *present = mikros_midl_get_presence(d, at + 8);
    if ((!*present && count != 0) || count > max || count > MIKROS_MIDL_MESSAGE_BYTES)
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
    return d->status == MIKROS_MIDL_OK ? count : 0;
}

/* Room for `count` decoded elements of `size` bytes in the arena. */
static inline void *mikros_midl_room(mikros_midl_decoder_t *d, uint64_t count, size_t size)
{
    if (d->status != MIKROS_MIDL_OK || count == 0)
        return NULL;
    void *p = mikros_midl_alloc(d->arena, (size_t)count * size);
    if (p == NULL)
        mikros_midl_decoder_fail(d, MIKROS_MIDL_NO_ROOM);
    return p;
}

/* The string at `at`, copied into the arena with a NUL after it. */
static inline mikros_midl_string_t mikros_midl_get_string(mikros_midl_decoder_t *d, uint64_t at,
                                                          uint64_t max, bool optional)
{
    mikros_midl_string_t s = {NULL, 0};
    bool present;
    uint64_t len = mikros_midl_get_vector(d, at, max, &present);
    if (!present) {
        if (!optional)
            mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return s;
    }
    uint32_t o = mikros_midl_claim(d, len);
    if (d->status != MIKROS_MIDL_OK)
        return s;
    if (!mikros_midl_utf8(d->bytes + o, len)) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return s;
    }
    char *copy = (char *)mikros_midl_alloc(d->arena, (size_t)len + 1);
    if (copy == NULL) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_NO_ROOM);
        return s;
    }
    memcpy(copy, d->bytes + o, (size_t)len);
    copy[len] = 0;
    s.data = copy;
    s.size = len;
    return s;
}

/* The vector of bytes at `at`, copied into the arena. */
static inline mikros_midl_vector_t mikros_midl_get_bytes(mikros_midl_decoder_t *d, uint64_t at,
                                                         uint64_t max, bool optional)
{
    mikros_midl_vector_t v = {NULL, 0};
    bool present;
    uint64_t count = mikros_midl_get_vector(d, at, max, &present);
    if (!present) {
        if (!optional)
            mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return v;
    }
    uint32_t o = mikros_midl_claim(d, count);
    /* Even an empty vector is present. */
    uint8_t *copy = (uint8_t *)mikros_midl_alloc(d->arena, count ? (size_t)count : 1);
    if (d->status != MIKROS_MIDL_OK)
        return v;
    if (copy == NULL) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_NO_ROOM);
        return v;
    }
    memcpy(copy, d->bytes + o, (size_t)count);
    v.data = copy;
    v.count = count;
    return v;
}

/* The handle whose marker is at `at`, or 0 when it is absent. When an
 * object type or rights are declared, it must be of `object`, have at
 * least `rights`, and is replaced with one that has exactly `rights`. */
#define MIKROS_MIDL_ANY UINT32_MAX

static inline mikros_handle_t mikros_midl_get_handle(mikros_midl_decoder_t *d, uint64_t at,
                                                     uint32_t object, uint32_t rights, bool optional)
{
    uint32_t marker = mikros_midl_get_u32(d, at);
    if (marker == 0) {
        if (!optional)
            mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return 0;
    }
    if (marker != UINT32_MAX || d->next_handle >= d->handle_count) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return 0;
    }
    if (d->status != MIKROS_MIDL_OK)
        return 0;
    uint32_t slot = d->next_handle++;
    mikros_handle_t h = d->handles[slot];
    if (object == MIKROS_MIDL_ANY && rights == MIKROS_MIDL_ANY)
        return h;
    uint8_t info[24];
    uint64_t len = 0;
    if (mikros_object_get_info(h, 1, info, sizeof info, &len) != 0 || len < sizeof info) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return 0;
    }
    uint32_t kind = (uint32_t)info[16] | (uint32_t)info[17] << 8 | (uint32_t)info[18] << 16 |
                    (uint32_t)info[19] << 24;
    uint32_t has = (uint32_t)info[20] | (uint32_t)info[21] << 8 | (uint32_t)info[22] << 16 |
                   (uint32_t)info[23] << 24;
    if ((object != MIKROS_MIDL_ANY && kind != object) ||
        (rights != MIKROS_MIDL_ANY && (has & rights) != rights)) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return 0;
    }
    if (rights == MIKROS_MIDL_ANY)
        return h;
    mikros_handle_t replaced = 0;
    /* The kernel consumes the handle even when it fails. */
    mikros_status_t s = mikros_handle_replace(h, rights, &replaced);
    d->handles[slot] = s == 0 ? replaced : 0;
    if (s != 0) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return 0;
    }
    return replaced;
}

static inline mikros_midl_mark_t mikros_midl_decoder_mark(const mikros_midl_decoder_t *d)
{
    mikros_midl_mark_t m = {d->next, d->next_handle};
    return m;
}

/* Fails unless exactly `bytes` and `handles` were read since `start`. */
static inline void mikros_midl_check_envelope(mikros_midl_decoder_t *d, mikros_midl_mark_t start,
                                              uint32_t bytes, uint32_t handles)
{
    if (d->next - start.bytes != bytes || d->next_handle - start.handles != handles)
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
}

/* Skips an unknown envelope's `bytes` and closes its `handles`. */
static inline void mikros_midl_skip(mikros_midl_decoder_t *d, uint32_t bytes, uint32_t handles)
{
    if (bytes % 8 != 0 || !mikros_midl_has(d, d->next, bytes) ||
        handles > d->handle_count - d->next_handle) {
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
        return;
    }
    d->next += bytes;
    for (uint32_t i = 0; i < handles; i++) {
        mikros_handle_close(d->handles[d->next_handle]);
        d->handles[d->next_handle++] = 0;
    }
}

/* The message's header: its ordinal and flags, after checking it. */
static inline void mikros_midl_header(mikros_midl_decoder_t *d, uint32_t *txid, uint32_t *ordinal,
                                      uint16_t *flags)
{
    *txid = mikros_midl_get_u32(d, 0);
    *ordinal = mikros_midl_get_u32(d, 4);
    *flags = mikros_midl_get_u16(d, 10);
    if (mikros_midl_get_u16(d, 8) != 1 || mikros_midl_get_u32(d, 12) != 0 ||
        (*flags & ~(MIKROS_MIDL_FLAG_UNKNOWN_METHOD | MIKROS_MIDL_FLAG_FLEXIBLE)) != 0)
        mikros_midl_decoder_fail(d, MIKROS_MIDL_INVALID);
}

/* Ends the decoding of a message: it must have been read whole. On
 * success the handles that the values hold are the caller's; on failure
 * every handle of the message is closed. */
static inline mikros_midl_status_t mikros_midl_decoder_finish(mikros_midl_decoder_t *d)
{
    if (d->status == MIKROS_MIDL_OK && (d->next != d->len || d->next_handle != d->handle_count))
        d->status = MIKROS_MIDL_INVALID;
    if (d->status != MIKROS_MIDL_OK)
        for (uint32_t i = 0; i < d->handle_count; i++)
            if (d->handles[i] != 0)
                mikros_handle_close(d->handles[i]);
    return d->status;
}

#ifdef __cplusplus
}
#endif

#endif
