+
+/// The error when no standard stream is a terminal, on Mikros, which has
+/// no /dev/tty to open instead.
+#[allow(dead_code)]
+fn no_terminal() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::NotFound,
+        "no terminal: standard input, output and error are not terminals, and Mikros has no /dev/tty",
+    )
+}
