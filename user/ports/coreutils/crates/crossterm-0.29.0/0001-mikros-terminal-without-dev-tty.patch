+            .ok_or_else(no_terminal)?;
+        let copy = unsafe { libc::dup(terminal) };
+        if copy < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        (copy, true)
     } else {
         (
             fs::OpenOptions::new()
@@ -146,9 +158,27 @@
     let stdin = rustix::stdio::stdin();
     let fd = if rustix::termios::isatty(stdin) {
