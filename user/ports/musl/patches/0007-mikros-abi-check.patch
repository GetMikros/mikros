+/* Mikros: whether the notes at offset off, size len, of the file fd hold
+ * the image's ABI levels with a minimum the running system provides. */
+uint32_t mikros_abi_level(void);
+static int abi_supported(int fd, off_t off, size_t len)
+{
+	unsigned char notes[256];
+	if (len > sizeof notes) len = sizeof notes;
+	if (pread(fd, notes, len, off) != len) return 0;
+	for (size_t at = 0; at + 12 <= len; ) {
+		uint32_t w[3];
+		memcpy(w, notes+at, sizeof w);
+		size_t name = at + 12, desc = name + ((w[0]+3) & -4);
+		size_t next = desc + ((w[1]+3) & -4);
+		if (next > len) return 0;
+		if (w[2] == 1 && w[0] == 7 && !memcmp(notes+name, "Mikros", 7) && w[1] == 8) {
+			uint32_t minimum;
+			memcpy(&minimum, notes+desc, sizeof minimum);
+			return minimum <= mikros_abi_level();
+		}
+		at = next;
+	}
+	return 0;
+}
