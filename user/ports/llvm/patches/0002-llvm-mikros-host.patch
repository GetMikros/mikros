diff -ruN a/llvm/cmake/config-ix.cmake b/llvm/cmake/config-ix.cmake
--- a/llvm/cmake/config-ix.cmake
+++ b/llvm/cmake/config-ix.cmake
@@ -57,7 +57,8 @@
   check_include_file(sys/ioctl.h HAVE_SYS_IOCTL_H)
 endif()
 
-if( UNIX AND NOT (APPLE OR BEOS OR HAIKU) )
+# Mikros has the math functions in its C library, and no libm.
+if( UNIX AND NOT (APPLE OR BEOS OR HAIKU OR CMAKE_SYSTEM_NAME STREQUAL "Mikros") )
   # Used by check_symbol_exists:
   list(APPEND CMAKE_REQUIRED_LIBRARIES "m")
 endif()
