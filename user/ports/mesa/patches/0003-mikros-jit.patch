@@ -666,7 +771,11 @@
 lp_get_default_memory_manager()
 {
    BaseMemoryManager *mm;
+#if DETECT_OS_MIKROS
+   mm = new DualMappingMemoryManager();
+#else
    mm = new llvm::SectionMemoryManager();
+#endif
    return reinterpret_cast<LLVMMCJITMemoryManagerRef>(mm);
 }
 
