 #include "lp_bld_misc.h"
 #include "lp_bld_debug.h"
@@ -216,7 +225,103 @@
       virtual bool finalizeMemory(std::string *ErrMsg = 0) {
          return mgr()->finalizeMemory(ErrMsg);
       }
