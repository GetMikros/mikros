+typedef struct VkImportMemoryHandleInfoMIKROS {
+    VkStructureType                       sType;
+    const void*                           pNext;
+    VkExternalMemoryHandleTypeFlagBits    handleType;
+    mikros_handle_t                       handle;
+} VkImportMemoryHandleInfoMIKROS;
+
+typedef struct VkMemoryHandlePropertiesMIKROS {
+    VkStructureType    sType;
+    void*              pNext;
+    uint32_t           memoryTypeBits;
+} VkMemoryHandlePropertiesMIKROS;
+
+typedef struct VkMemoryGetHandleInfoMIKROS {
+    VkStructureType                       sType;
+    const void*                           pNext;
+    VkDeviceMemory                        memory;
+    VkExternalMemoryHandleTypeFlagBits    handleType;
+} VkMemoryGetHandleInfoMIKROS;
+
+typedef VkResult (VKAPI_PTR *PFN_vkGetMemoryHandleMIKROS)(VkDevice device, const VkMemoryGetHandleInfoMIKROS* pGetHandleInfo, mikros_handle_t* pHandle);
+typedef VkResult (VKAPI_PTR *PFN_vkGetMemoryHandlePropertiesMIKROS)(VkDevice device, VkExternalMemoryHandleTypeFlagBits handleType, mikros_handle_t handle, VkMemoryHandlePropertiesMIKROS* pMemoryHandleProperties);
+
+#ifndef VK_NO_PROTOTYPES
+VKAPI_ATTR VkResult VKAPI_CALL vkGetMemoryHandleMIKROS(
+    VkDevice                                    device,
+    const VkMemoryGetHandleInfoMIKROS*          pGetHandleInfo,
+    mikros_handle_t*                            pHandle);
+
+VKAPI_ATTR VkResult VKAPI_CALL vkGetMemoryHandlePropertiesMIKROS(
+    VkDevice                                    device,
+    VkExternalMemoryHandleTypeFlagBits          handleType,
+    mikros_handle_t                             handle,
