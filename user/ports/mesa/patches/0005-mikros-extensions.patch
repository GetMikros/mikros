+typedef struct VkImportSemaphoreHandleInfoMIKROS {
+    VkStructureType                          sType;
+    const void*                              pNext;
+    VkSemaphore                              semaphore;
+    VkSemaphoreImportFlags                   flags;
+    VkExternalSemaphoreHandleTypeFlagBits    handleType;
+    mikros_handle_t                          handle;
+} VkImportSemaphoreHandleInfoMIKROS;
+
+typedef struct VkSemaphoreGetHandleInfoMIKROS {
+    VkStructureType                          sType;
+    const void*                              pNext;
+    VkSemaphore                              semaphore;
+    VkExternalSemaphoreHandleTypeFlagBits    handleType;
+} VkSemaphoreGetHandleInfoMIKROS;
+
+typedef VkResult (VKAPI_PTR *PFN_vkImportSemaphoreHandleMIKROS)(VkDevice device, const VkImportSemaphoreHandleInfoMIKROS* pImportSemaphoreHandleInfo);
+typedef VkResult (VKAPI_PTR *PFN_vkGetSemaphoreHandleMIKROS)(VkDevice device, const VkSemaphoreGetHandleInfoMIKROS* pGetHandleInfo, mikros_handle_t* pHandle);
+
+#ifndef VK_NO_PROTOTYPES
+VKAPI_ATTR VkResult VKAPI_CALL vkImportSemaphoreHandleMIKROS(
+    VkDevice                                    device,
+    const VkImportSemaphoreHandleInfoMIKROS*    pImportSemaphoreHandleInfo);
+
+VKAPI_ATTR VkResult VKAPI_CALL vkGetSemaphoreHandleMIKROS(
+    VkDevice                                    device,
+    const VkSemaphoreGetHandleInfoMIKROS*       pGetHandleInfo,
+    mikros_handle_t*                            pHandle);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
