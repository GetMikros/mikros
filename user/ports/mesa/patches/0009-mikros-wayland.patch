diff -ruN a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -2261,7 +2261,10 @@
 if with_platform_wayland
   dep_wl_protocols = dependency('wayland-protocols', version : '>= 1.49', default_options: [ 'tests=false' ])
   dep_wayland_client = dependency('wayland-client', version : '>=1.18')
-  dep_wayland_server = dependency('wayland-server', version : '>=1.18')
+  # Mikros has the client library alone, and Mesa needs the server's only
+  # for EGL and GBM.
+  dep_wayland_server = dependency('wayland-server', version : '>=1.18',
+                                  required : host_machine.system() != 'mikros')
   if with_egl
     dep_wayland_egl = dependency('wayland-egl-backend', version : '>= 3')
     dep_wayland_egl_headers = dep_wayland_egl.partial_dependency(compile_args : true)
