+#ifdef VK_USE_PLATFORM_MIKROS
+VKAPI_ATTR VkResult VKAPI_CALL
+lvp_GetMemoryHandleMIKROS(VkDevice _device, const VkMemoryGetHandleInfoMIKROS *pGetHandleInfo,
+                          mikros_handle_t *pHandle)
+{
+   VK_FROM_HANDLE(lvp_device, device, _device);
+   VK_FROM_HANDLE(lvp_device_memory, memory, pGetHandleInfo->memory);
+
+   assert(pGetHandleInfo->sType == VK_STRUCTURE_TYPE_MEMORY_GET_HANDLE_INFO_MIKROS);
+   assert_memhandle_type(pGetHandleInfo->handleType);
+
+   const bool token = pGetHandleInfo->handleType == VK_EXTERNAL_MEMORY_HANDLE_TYPE_TOKEN_BIT_MIKROS;
+   *pHandle = llvmpipe_mikros_export(device->pscreen, memory->pmem, token);
+   if (*pHandle == 0)
+      return vk_error(device, VK_ERROR_TOO_MANY_OBJECTS);
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+lvp_GetMemoryHandlePropertiesMIKROS(VkDevice _device,
+                                    VkExternalMemoryHandleTypeFlagBits handleType,
+                                    mikros_handle_t handle,
+                                    VkMemoryHandlePropertiesMIKROS *pMemoryHandleProperties)
+{
+   VK_FROM_HANDLE(lvp_device, device, _device);
+
+   if (!assert_memhandle_type(handleType) || handle == 0)
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   pMemoryHandleProperties->memoryTypeBits = 1;
+   return VK_SUCCESS;
+}
+#endif
