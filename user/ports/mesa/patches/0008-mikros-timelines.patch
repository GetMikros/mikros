+#ifdef VK_USE_PLATFORM_MIKROS
+VKAPI_ATTR VkResult VKAPI_CALL
+vk_common_ImportSemaphoreHandleMIKROS(VkDevice _device,
+                                      const VkImportSemaphoreHandleInfoMIKROS *pImportSemaphoreHandleInfo)
+{
+   VK_FROM_HANDLE(vk_device, device, _device);
+   VK_FROM_HANDLE(vk_semaphore, semaphore, pImportSemaphoreHandleInfo->semaphore);
+
+   assert(pImportSemaphoreHandleInfo->sType ==
+          VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_HANDLE_INFO_MIKROS);
+
+   if (pImportSemaphoreHandleInfo->handleType !=
+          VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_TIMELINE_BIT_MIKROS ||
+       pImportSemaphoreHandleInfo->flags != 0)
+      return vk_error(semaphore, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   struct vk_sync *sync = &semaphore->permanent;
+   if (sync->type->import_mikros_handle == NULL)
+      return vk_error(semaphore, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   VkResult result = sync->type->import_mikros_handle(device, sync,
+                                                      pImportSemaphoreHandleInfo->handle);
+   if (result == VK_SUCCESS)
+      sync->flags |= VK_SYNC_IS_SHAREABLE | VK_SYNC_IS_SHARED;
+   return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vk_common_GetSemaphoreHandleMIKROS(VkDevice _device,
+                                   const VkSemaphoreGetHandleInfoMIKROS *pGetHandleInfo,
+                                   mikros_handle_t *pHandle)
+{
+   VK_FROM_HANDLE(vk_device, device, _device);
+   VK_FROM_HANDLE(vk_semaphore, semaphore, pGetHandleInfo->semaphore);
+
+   assert(pGetHandleInfo->sType == VK_STRUCTURE_TYPE_SEMAPHORE_GET_HANDLE_INFO_MIKROS);
+
+   struct vk_sync *sync = vk_semaphore_get_active_sync(semaphore);
+   if (pGetHandleInfo->handleType != VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_TIMELINE_BIT_MIKROS ||
+       sync->type->export_mikros_handle == NULL)
+      return vk_error(semaphore, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   VkResult result = sync->type->export_mikros_handle(device, sync, pHandle);
+   if (result == VK_SUCCESS)
+      sync->flags |= VK_SYNC_IS_SHARED;
+   return result;
+}
+#endif
diff -ruN a/src/gallium/frontends/lavapipe/lvp_mikros_sync.c b/src/gallium/frontends/lavapipe/lvp_mikros_sync.c
--- /dev/null
+++ b/src/gallium/frontends/lavapipe/lvp_mikros_sync.c
@@ -0,0 +1,141 @@
+#include "lvp_private.h"
+
+#include <mikros/startup.h>
+#include <mikros/syscalls.h>
+
+#define HANDLE_DESCRIPTOR 10u
+#define OBJECT_TIMELINE 14u
+/* The rights of an exported timeline, which an imported one needs:
+ * DUPLICATE, TRANSFER, READ, WAIT, SIGNAL and INSPECT. */
+#define TIMELINE_RIGHTS ((1u << 0) | (1u << 1) | (1u << 2) | (1u << 6) | (1u << 7) | (1u << 9))
+#define STATUS_TIMED_OUT (-21)
+
+struct lvp_mikros_timeline {
+   struct vk_sync base;
+   mikros_handle_t timeline;
+};
+
+static struct lvp_mikros_timeline *
+to_timeline(struct vk_sync *sync)
+{
+   return container_of(sync, struct lvp_mikros_timeline, base);
+}
+
+static VkResult
+lvp_mikros_timeline_init(struct vk_device *device, struct vk_sync *sync, uint64_t initial_value)
+{
+   struct lvp_mikros_timeline *t = to_timeline(sync);
+   if (mikros_timeline_create(initial_value, 0, &t->timeline) != 0)
+      return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+   return VK_SUCCESS;
+}
+
+static void
+lvp_mikros_timeline_finish(struct vk_device *device, struct vk_sync *sync)
+{
+   mikros_handle_close(to_timeline(sync)->timeline);
+}
+
+static VkResult
+lvp_mikros_timeline_signal(struct vk_device *device, struct vk_sync *sync, uint64_t value)
+{
+   if (mikros_timeline_signal(to_timeline(sync)->timeline, value) != 0)
+      return vk_device_set_lost(device, "signalling a kernel timeline failed");
+   return VK_SUCCESS;
+}
+
+static VkResult
+lvp_mikros_timeline_get_value(struct vk_device *device, struct vk_sync *sync, uint64_t *value)
+{
+   if (mikros_timeline_get(to_timeline(sync)->timeline, value) != 0)
+      return vk_device_set_lost(device, "reading a kernel timeline failed");
+   return VK_SUCCESS;
+}
+
+/* A kernel timeline knows nothing of signal operations still to come, so
+ * a wait for one to be pending waits for its value. */
+static VkResult
+lvp_mikros_timeline_wait(struct vk_device *device, struct vk_sync *sync, uint64_t wait_value,
+                         enum vk_sync_wait_flags wait_flags, uint64_t abs_timeout_ns)
+{
+   int64_t deadline = abs_timeout_ns > INT64_MAX ? INT64_MAX : (int64_t)abs_timeout_ns;
+   mikros_status_t s = mikros_timeline_wait(to_timeline(sync)->timeline, wait_value, deadline);
+   if (s == STATUS_TIMED_OUT)
+      return VK_TIMEOUT;
+   if (s != 0)
+      return vk_device_set_lost(device, "waiting for a kernel timeline failed");
+   return VK_SUCCESS;
+}
+
+static VkResult
+lvp_mikros_timeline_import(struct vk_device *device, struct vk_sync *sync, uint32_t handle)
+{
+   uint8_t info[24];
+   uint64_t len = 0;
+   if (mikros_object_get_info(handle, 1, info, sizeof info, &len) != 0 || len < sizeof info ||
+       ((uint32_t)info[16] | (uint32_t)info[17] << 8 | (uint32_t)info[18] << 16 |
+        (uint32_t)info[19] << 24) != OBJECT_TIMELINE)
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   uint32_t rights = (uint32_t)info[20] | (uint32_t)info[21] << 8 | (uint32_t)info[22] << 16 |
+                     (uint32_t)info[23] << 24;
+   if ((rights & TIMELINE_RIGHTS) != TIMELINE_RIGHTS)
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   struct lvp_mikros_timeline *t = to_timeline(sync);
+   mikros_handle_close(t->timeline);
+   t->timeline = handle;
+   return VK_SUCCESS;
+}
+
+static VkResult
+lvp_mikros_timeline_export(struct vk_device *device, struct vk_sync *sync, uint32_t *handle)
+{
+   if (mikros_handle_duplicate(to_timeline(sync)->timeline, TIMELINE_RIGHTS, handle) != 0)
+      return vk_error(device, VK_ERROR_TOO_MANY_OBJECTS);
+   return VK_SUCCESS;
+}
+
+static VkResult
+lvp_mikros_timeline_import_fd(struct vk_device *device, struct vk_sync *sync, int fd)
+{
+   mikros_handle_t handle;
+   if (mikros_handle_from_fd(fd, &handle) != 0)
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   VkResult result = lvp_mikros_timeline_import(device, sync, handle);
+   if (result != VK_SUCCESS)
+      mikros_handle_close(handle);
+   return result;
+}
+
+static VkResult
+lvp_mikros_timeline_export_fd(struct vk_device *device, struct vk_sync *sync, int *fd)
+{
+   mikros_handle_t handle;
+   VkResult result = lvp_mikros_timeline_export(device, sync, &handle);
+   if (result != VK_SUCCESS)
+      return result;
+   *fd = mikros_fd_from_handle(handle, HANDLE_DESCRIPTOR);
+   if (*fd < 0) {
+      mikros_handle_close(handle);
+      return vk_error(device, VK_ERROR_TOO_MANY_OBJECTS);
+   }
+   return VK_SUCCESS;
+}
+
+const struct vk_sync_type lvp_mikros_timeline_type = {
+   .size = sizeof(struct lvp_mikros_timeline),
+   .features = VK_SYNC_FEATURE_TIMELINE |
+               VK_SYNC_FEATURE_GPU_WAIT |
+               VK_SYNC_FEATURE_CPU_WAIT |
+               VK_SYNC_FEATURE_CPU_SIGNAL |
+               VK_SYNC_FEATURE_WAIT_PENDING |
+               VK_SYNC_FEATURE_WAIT_BEFORE_SIGNAL,
+   .init = lvp_mikros_timeline_init,
+   .finish = lvp_mikros_timeline_finish,
+   .signal = lvp_mikros_timeline_signal,
+   .get_value = lvp_mikros_timeline_get_value,
+   .wait = lvp_mikros_timeline_wait,
+   .import_opaque_fd = lvp_mikros_timeline_import_fd,
+   .export_opaque_fd = lvp_mikros_timeline_export_fd,
+   .import_mikros_handle = lvp_mikros_timeline_import,
+   .export_mikros_handle = lvp_mikros_timeline_export,
+};
