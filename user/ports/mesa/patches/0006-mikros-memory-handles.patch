+/* The rights that a duplicate keeps: all of the original's. */
+#define SAME_RIGHTS (1u << 31)
+/* The kinds of the C library's descriptors of memory objects and of
+ * other handles, and the kernel's object types of their objects. */
+#define HANDLE_DESCRIPTOR 10u
+#define OBJECT_MEMORY 3u
+#define OBJECT_EVENT 5u
+
+uint32_t
+lp_mikros_handle_copy(uint32_t handle)
+{
+   mikros_handle_t copy = 0;
+   if (mikros_handle_duplicate(handle, SAME_RIGHTS, &copy) != 0)
+      return 0;
+   return copy;
+}
+
+int
+lp_mikros_memory_fd(uint32_t memory)
+{
+   mikros_handle_t copy = lp_mikros_handle_copy(memory);
+   if (copy == 0)
+      return -1;
+   int fd = mikros_fd_from_handle(copy, MEMORY_DESCRIPTOR);
+   if (fd < 0)
+      mikros_handle_close(copy);
+   return fd;
+}
+
+/* `size` bytes of the memory object `memory` mapped writable, or NULL. */
+static void *
+map_memory(uint32_t memory, uint64_t size)
+{
+   int fd = lp_mikros_memory_fd(memory);
+   if (fd < 0)
+      return NULL;
+   void *map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   close(fd);
+   return map == MAP_FAILED ? NULL : map;
+}
+
+/* The kernel's object type of `handle`, or 0. */
+static uint32_t
+object_type(mikros_handle_t handle)
+{
+   uint8_t info[24];
+   uint64_t len = 0;
+   if (mikros_object_get_info(handle, 1, info, sizeof info, &len) != 0 || len < sizeof info)
+      return 0;
+   return (uint32_t)info[16] | (uint32_t)info[17] << 8 | (uint32_t)info[18] << 16 |
+          (uint32_t)info[19] << 24;
+}
