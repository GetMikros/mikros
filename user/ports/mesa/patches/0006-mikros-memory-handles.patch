-#ifdef PIPE_MEMORY_FD
+#if DETECT_OS_MIKROS
+static struct pipe_memory_allocation *
+llvmpipe_allocate_memory_fd(struct pipe_screen *pscreen,
+                            uint64_t size,
+                            int *out_fd,
+                            bool dmabuf)
+{
+   struct llvmpipe_memory_allocation *mem =
+      (struct llvmpipe_memory_allocation *)llvmpipe_allocate_memory(pscreen, size);
+   if (!mem)
+      return NULL;
+   *out_fd = lp_mikros_memory_fd(mem->memory);
+   if (*out_fd < 0) {
