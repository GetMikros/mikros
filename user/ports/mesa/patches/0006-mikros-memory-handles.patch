+}
+
+void *
+lp_mikros_buffer_import(uint32_t render, uint32_t from, uint32_t *buffer, uint32_t *memory,
+                        uint64_t *size)
+{
+   mikros_handle_t handle = lp_mikros_handle_copy(from);
+   if (handle == 0)
+      return NULL;
+   mikros_midl_arena_t arena;
+   if (!arena_new(&arena)) {
+      mikros_handle_close(handle);
+      return NULL;
+   }
+   mikros_base_Status error;
+   bool imported = false;
+   switch (object_type(handle)) {
+   case OBJECT_EVENT: {
+      /* An export token, which the import takes. */
+      mikros_gpu_Render_ImportBuffer_Response r = {0};
+      if (mikros_gpu_Render_ImportBuffer(render, handle, &r, &error, INT64_MAX, &arena) ==
+             MIKROS_MIDL_OK && r.memory != 0) {
+         *buffer = r.buffer;
+         *memory = r.memory;
+         *size = r.size;
+         imported = true;
+      } else if (r.memory != 0) {
+         mikros_handle_close(r.memory);
+      }
+      break;
+   }
+   case OBJECT_MEMORY: {
+      /* A memory object, which the import takes a copy of. */
+      mikros_handle_t copy = lp_mikros_handle_copy(handle);
+      mikros_gpu_Render_ImportMemory_Response r;
+      if (copy != 0 && mikros_gpu_Render_ImportMemory(render, copy, &r, &error, INT64_MAX,
+                                                      &arena) == MIKROS_MIDL_OK) {
+         *buffer = r.buffer;
+         *memory = handle;
+         *size = r.size;
+         imported = true;
+      } else {
+         mikros_handle_close(handle);
+      }
+      break;
+   }
+   default:
+      mikros_handle_close(handle);
+      break;
+   }
+   arena_free(&arena);
+   if (!imported)
+      return NULL;
+   void *map = map_memory(*memory, *size);
+   if (map == NULL)
+      lp_mikros_buffer_destroy(render, *buffer, NULL, 0, *memory);
    return map;
 }
 
+uint32_t
+lp_mikros_buffer_token(uint32_t render, uint32_t buffer)
+{
+   mikros_midl_arena_t arena;
+   if (!arena_new(&arena))
+      return 0;
+   mikros_base_Status error;
+   mikros_gpu_Render_ExportBuffer_Response r;
+   mikros_midl_status_t s =
+      mikros_gpu_Render_ExportBuffer(render, buffer, &r, &error, INT64_MAX, &arena);
+   arena_free(&arena);
+   return s == MIKROS_MIDL_OK ? r.token : 0;
+}
