+llvmpipe_mikros_import(struct pipe_screen *screen, uint32_t handle,
+                       struct pipe_memory_allocation **out_ptr, uint64_t *out_size)
+{
+   struct llvmpipe_memory_allocation *mem = CALLOC_STRUCT(llvmpipe_memory_allocation);
+   if (!mem)
+      return false;
+   mem->fd = -1;
+   mem->type = LLVMPIPE_MEMORY_FD_TYPE_INVALID;
+   mem->cpu_addr = lp_mikros_buffer_import(llvmpipe_screen(screen)->render, handle,
+                                           &mem->buffer, &mem->memory, &mem->size);
+   if (!mem->cpu_addr) {
