+static bool
+llvmpipe_import_memory_fd(struct pipe_screen *screen,
+                          int fd,
+                          struct pipe_memory_allocation **out_ptr,
+                          uint64_t *out_size,
+                          bool dmabuf)
+{
+   mikros_handle_t handle;
+   if (mikros_handle_from_fd(fd, &handle) != 0)
+      return false;
+   bool imported = llvmpipe_mikros_import(screen, handle, out_ptr, out_size);
+   mikros_handle_close(handle);
+   return imported;
+}
+
+static void
+llvmpipe_free_memory_fd(struct pipe_screen *screen,
+                        struct pipe_memory_allocation *pmem)
+{
