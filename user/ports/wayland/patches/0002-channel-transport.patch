+/* The kind of descriptor that a received handle becomes, from its object
+ * type. */
+static uint32_t
+descriptor_kind(mikros_handle_t handle)
+{
+	uint8_t record[24];
+	uint64_t len = 0;
+	uint32_t type = 0;
+
+	if (mikros_object_get_info(handle, INFO_BASIC, record, sizeof record,
+				   &len) == STATUS_OK && len >= sizeof record)
+		memcpy(&type, record + 16, sizeof type);
+	switch (type) {
+	case TYPE_MEMORY:
+		return KIND_MEMORY;
+	case TYPE_STREAM:
+		return KIND_PIPE;
+	default:
+		return KIND_HANDLE;
+	}
+}
+
+/* Moves as much of the carried part of the last channel message into the
+ * in buffer as it has room for, growing it up to its largest size, and
+ * returns whether all of it moved. */
+static int
+move_carried(struct wl_connection *connection)
+{
+	struct wl_ring_buffer *in = &connection->in;
+	size_t count = connection->carry_end - connection->carry_start;
+	size_t room;
+
+	if (count == 0)
+		return 1;
+	if (in->max_size_bits > 0) {
+		room = size_pot(in->max_size_bits) - ring_buffer_size(in);
+		if (count > room)
+			count = room;
+		if (count == 0)
+			return 0;
+	}
+	if (ring_buffer_ensure_space(in, count) < 0 ||
+	    ring_buffer_put(in, connection->message + connection->carry_start,
+			    count) < 0)
+		return 0;
+	connection->carry_start += count;
+	return connection->carry_start == connection->carry_end;
+}
