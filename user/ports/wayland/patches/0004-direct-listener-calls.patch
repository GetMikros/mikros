+/* Wayland's arguments are all of integer or pointer size, never floating
+ * point or aggregates, and listeners are never variadic. On the x86-64
+ * System V ABI, the only one of Mikros, a listener can therefore be called
+ * through a pointer to a function of WL_CLOSURE_MAX_ARGS + 2 uint64_t
+ * parameters: the first six go in registers and the others in 8-byte stack
+ * slots, where its own parameters would be, it reads its 32-bit ones from
+ * their low halves, and the caller removes the stack arguments, so that
+ * those it does not declare do no harm. This cast is not portable C: it is
+ * valid only for that ABI, which is why libffi is not needed. */
+#if !defined(__x86_64__) || defined(_WIN32)
+#error "listeners are called directly only on the x86-64 System V ABI"
+#endif
+
+typedef void (*listener_call_t)(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t);
+_Static_assert(WL_CLOSURE_MAX_ARGS + 2 == 22,
+	       "listener_call_t takes WL_CLOSURE_MAX_ARGS + 2 arguments");
