+/// Spawns `program` from the first directory of `path`, the child's
+/// `PATH`, or of the C library's default when it has none, that holds it,
+/// with `posix_spawn`, going on past directories that do not have it or
+/// may not be searched, as `execvp` does.
+#[cfg(target_os = "mikros")]
+unsafe fn spawn_in_path(
+    pid: *mut pid_t,
+    path: Option<&crate::ffi::OsStr>,
+    program: &crate::ffi::CStr,
+    file_actions: *const libc::posix_spawn_file_actions_t,
+    attrs: *const libc::posix_spawnattr_t,
+    argv: *const *mut libc::c_char,
+    envp: *const *mut libc::c_char,
+) -> c_int {
+    use crate::os::unix::ffi::OsStrExt;
+    let path = path.map_or(&b"/usr/local/bin:/bin:/usr/bin"[..], |p| p.as_bytes());
+    let mut error = libc::ENOENT;
+    for dir in path.split(|&b| b == b':') {
+        let dir = if dir.is_empty() { &b"."[..] } else { dir };
+        let mut candidate = Vec::with_capacity(dir.len() + program.count_bytes() + 1);
+        candidate.extend_from_slice(dir);
+        candidate.push(b'/');
+        candidate.extend_from_slice(program.to_bytes());
+        let Ok(candidate) = crate::ffi::CString::new(candidate) else { continue };
+        match unsafe { libc::posix_spawn(pid, candidate.as_ptr(), file_actions, attrs, argv, envp) } {
+            libc::ENOENT | libc::ENOTDIR => {}
+            libc::EACCES => error = libc::EACCES,
+            r => return r,
+        }
+    }
+    error
+}
