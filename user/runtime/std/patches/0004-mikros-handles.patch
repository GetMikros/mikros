@@ -0,0 +1,30 @@
+//! Mikros-specific extensions to primitives in the [`std::process`]
+//! module.
+//!
+//! [`std::process`]: crate::process
+
+#![unstable(feature = "mikros_handles", issue = "none")]
+
+use super::io::{OwnedHandle, owned};
+use crate::ffi::c_int;
+use crate::io;
+use crate::process::Child;
+
+unsafe extern "C" {
+    fn mikros_process_handle(pid: c_int) -> i64;
+}
+
+/// The kernel handle of a child process.
+pub trait ChildExt {
+    /// Takes the process handle that the process manager gave for the
+    /// child when it started it, which the caller then owns. It can be
+    /// taken once, until the child is waited for; later calls fail.
+    fn take_process_handle(&mut self) -> io::Result<OwnedHandle>;
+}
+
+impl ChildExt for Child {
+    fn take_process_handle(&mut self) -> io::Result<OwnedHandle> {
+        // SAFETY: the call takes no pointers.
+        owned(unsafe { mikros_process_handle(self.id() as c_int) })
+    }
+}
