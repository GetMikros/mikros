+/// The process's `Launcher` connection from its startup transfer, which
+/// the C library keeps open for as long as the process runs, for calls
+/// such as `Spawn` with startup handles (MIKSPEC-0060.R15).
+pub fn launcher() -> BorrowedHandle<'static> {
+    // SAFETY: the call takes no pointers, and the C library never closes
+    // the connection.
+    unsafe { BorrowedHandle::borrow_raw(mikros_launcher()) }
+}
