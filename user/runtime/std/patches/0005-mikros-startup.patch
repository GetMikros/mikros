@@ -0,0 +1,20 @@
+//! The startup handles that the C library did not install as
+//! descriptors.
+
+#![unstable(feature = "mikros_handles", issue = "none")]
+
+use super::io::{OwnedHandle, RawHandle};
+
+unsafe extern "C" {
+    fn mikros_take_startup_handle(role: u32, id: u32) -> RawHandle;
+}
+
+/// The startup handle with `role` and `id` that the C library did not
+/// install as a descriptor or keep, which the caller owns from then on,
+/// once: `None` after that and for a handle the process did not get.
+pub fn take_handle(role: u32, id: u32) -> Option<OwnedHandle> {
+    // SAFETY: the call takes no pointers.
+    let raw = unsafe { mikros_take_startup_handle(role, id) };
+    // SAFETY: the C library hands the handle over to the caller.
+    (raw != 0).then(|| unsafe { OwnedHandle::from_raw_handle(raw) })
+}
