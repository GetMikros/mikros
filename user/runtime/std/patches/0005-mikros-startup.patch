 pub mod io;
 pub mod process;
 pub mod raw;
+pub mod startup;
+
+unsafe extern "C" {
+    fn mikros_directory() -> io::RawHandle;
+}
+
+/// The process's `Directory` connection, which the C library keeps open
+/// for as long as the process runs.
+#[unstable(feature = "mikros_handles", issue = "none")]
+pub fn directory() -> io::BorrowedHandle<'static> {
+    // SAFETY: the call takes no pointers, and the C library never closes
+    // the connection.
+    unsafe { io::BorrowedHandle::borrow_raw(mikros_directory()) }
+}
