+/// A kernel handle that this value borrows for `'a`, without closing it.
+#[derive(Clone, Copy)]
+pub struct BorrowedHandle<'a> {
+    raw: RawHandle,
+    _owner: crate::marker::PhantomData<&'a OwnedHandle>,
+}
+
+impl BorrowedHandle<'_> {
+    /// Borrows the handle `raw`.
+    ///
+    /// # Safety
+    ///
+    /// `raw` must stay open for the lifetime of the borrow.
+    pub unsafe fn borrow_raw(raw: RawHandle) -> Self {
+        BorrowedHandle { raw, _owner: crate::marker::PhantomData }
+    }
+
+    /// The handle's value, which stays owned by its owner.
+    pub fn as_raw_handle(&self) -> RawHandle {
+        self.raw
+    }
+}
+
+impl fmt::Debug for BorrowedHandle<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("BorrowedHandle").field("raw", &self.raw).finish()
+    }
+}
+
