     unsafe fn sanitize_standard_fds() {
+        // Mikros's C library keeps the descriptors 0, 1 and 2 that the
+        // process was started without reserved, so that no `open` returns
+        // them: /dev/null is opened once, placed on each of them with
+        // `dup2`, and closed again (MIKSPEC-0060.R16). Without /dev/null
+        // they stay reserved.
+        #[cfg(target_os = "mikros")]
+        {
+            use crate::sys::io::errno;
+            let mut devnull = -1;
+            for fd in 0..3 {
+                if libc::fcntl(fd, libc::F_GETFD) != -1 || errno() != libc::EBADF {
+                    continue;
+                }
+                if devnull == -1 {
+                    devnull = libc::open(c"/dev/null".as_ptr(), libc::O_RDWR, 0);
+                    if devnull == -1 {
+                        return;
+                    }
+                }
+                libc::dup2(devnull, fd);
+            }
+            if devnull != -1 {
+                libc::close(devnull);
+            }
+        }
+
