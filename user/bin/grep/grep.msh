# What `grep` takes, for msh's completion and colours. The command
# answers completion itself, from the same tables.
extern grep(
    pattern?: string "the pattern, unless -e or -f gives it",
    ...file: path "the files to search, or - for standard input",
    --regexp(-e): string "a pattern to match",
    --file(-f): file "read patterns from a file, one per line",
    --extended-regexp(-E): bool "patterns are extended regular expressions",
    --fixed-strings(-F): bool "patterns are fixed strings",
    --ignore-case(-i): bool "ignore the case of letters",
    --invert-match(-v): bool "select the lines that do not match",
    --word-regexp(-w): bool "match whole words only",
    --line-regexp(-x): bool "match whole lines only",
    --count(-c): bool "write the number of selected lines of each file",
    --files-with-matches(-l): bool "write the names of the files with selected lines",
    --files-without-match(-L): bool "write the names of the files without selected lines",
    --line-number(-n): bool "write the number of each line",
    --no-filename(-h): bool "never write the names of files",
    --with-filename(-H): bool "write the name of the file of each line",
    --only-matching(-o): bool "write only the matching parts of lines",
    --quiet(-q): bool "write nothing, and stop at the first match",
    --no-messages(-s): bool "say nothing of files that are missing or unreadable",
    --recursive(-r): bool "search folders, without following links in them",
    --dereference-recursive(-R): bool "search folders, following links in them",
    --after-context(-A): int "write lines after each selected line",
    --before-context(-B): int "write lines before each selected line",
    --context(-C): int "write lines around each selected line",
    --include: string "search only files whose names match",
    --exclude: string "skip files whose names match",
    --max-count(-m): int "stop after this many selected lines",
    --null-data(-z): bool "lines end with NUL, not line feed",
    --json: bool "write the selected lines as a JSON array of objects",
    --help: bool "show how to use the command and exit",
    --color: [auto always never] "colour the output: auto, always or never"
) complete
