# What `logs` takes, for msh's completion and colours. Its short options
# -n and -f have no long forms, which a declaration needs, so they are
# left out.
extern logs(
    --app: string "print only the records of this app ID",
    --pid: int "print only the records of this process",
    --severity: [debug info warning error] "print only the records of this severity or higher",
    --json: bool "write the records as JSON",
    --help: bool "show how to use logs"
)
