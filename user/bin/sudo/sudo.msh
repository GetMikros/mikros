# What `sudo` takes, for msh's completion and colours. The command
# answers completion itself, from the same tables.
extern sudo(
    command: command "the command to run as an authorized administrator",
    ...arguments: string "the command's arguments",
    --help: bool "show how to use the command and exit",
    --color: [auto always never] "colour the output: auto, always or never"
) complete
