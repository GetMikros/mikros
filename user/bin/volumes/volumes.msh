# What `volumes` takes, for msh's completion and colours. The command
# answers completion itself, from the same tables.
extern volumes(
    --json: bool "write the volumes as a JSON array of objects",
    --help: bool "show how to use the command and exit",
    --color: [auto always never] "colour the output: auto, always or never"
) complete
extern volumes eject(
    volume: volume "the name in /volumes or the ID of the volume"
) complete
extern volumes mount(
    id: volume "the ID of the volume"
) complete
