# What `env` takes, for msh's completion and colours. The command
# answers completion itself, from the same tables.
extern env(
    ...command: command "name=value settings, then the command to run and its arguments",
    --ignore-environment(-i): bool "start with an empty environment",
    --unset(-u): string "remove the variable from the environment",
    --chdir(-C): folder "run the command in this folder",
    --null(-0): bool "end each variable written with NUL, not a line feed",
    --help: bool "show how to use the command and exit",
    --color: [auto always never] "colour the output: auto, always or never"
) complete
