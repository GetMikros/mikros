# What `find` takes, for msh's completion and colours. The command
# answers completion itself, from the same tables.
extern find(
    ...path: path "the folders to walk, or the current one",
    -L: bool "follow links, before the paths",
    --json: bool "write the entries as a JSON array of objects",
    --help: bool "show how to use the command and exit",
    --color: [auto always never] "colour the output: auto, always or never"
) complete
