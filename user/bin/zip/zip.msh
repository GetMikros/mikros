# What `zip` takes, for msh's completion and colours. The command
# answers completion itself, from the same tables.
extern zip(
    archive: file "the zip archive to create or change",
    ...path: path "the files and folders to add, or with -d the entries to remove",
    -r: bool "add folders with what they hold",
    -q: bool "print nothing but errors",
    -0: bool "store without compressing",
    -1: bool "deflate, fastest",
    -2: bool "deflate at level 2",
    -3: bool "deflate at level 3",
    -4: bool "deflate at level 4",
    -5: bool "deflate at level 5",
    -6: bool "deflate at level 6, as without a level",
    -7: bool "deflate at level 7",
    -8: bool "deflate at level 8",
    -9: bool "deflate, smallest",
    -d: bool "remove the entries that the names match, as wildcard patterns",
    -j: bool "store the names without their folders",
    -y: bool "store links as links instead of what they lead to",
    -x: string "leave out the paths that this pattern matches",
    --help: bool "show how to use the command and exit",
    --color: [auto always never] "colour the output: auto, always or never"
) complete
