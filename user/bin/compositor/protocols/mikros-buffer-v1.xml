<?xml version="1.0" encoding="UTF-8"?>
<protocol name="mikros_buffer_v1">
  <description summary="MIKSPEC-0076.R18"/>

  <interface name="mikros_buffer_v1" version="1">
    <description summary="MIKSPEC-0076.R18"/>

    <request name="create_from_token">
      <arg name="id" type="new_id" interface="wl_buffer"/>
      <arg name="token" type="fd"/>
      <arg name="width" type="uint"/>
      <arg name="height" type="uint"/>
      <arg name="format" type="uint"/>
      <arg name="modifier_hi" type="uint"/>
      <arg name="modifier_lo" type="uint"/>
      <arg name="stride" type="uint"/>
      <arg name="offset" type="uint"/>
    </request>

    <request name="create_from_memory">
      <arg name="id" type="new_id" interface="wl_buffer"/>
      <arg name="memory" type="fd"/>
      <arg name="width" type="uint"/>
      <arg name="height" type="uint"/>
      <arg name="format" type="uint"/>
      <arg name="stride" type="uint"/>
      <arg name="offset" type="uint"/>
    </request>

    <request name="import_timeline">
      <arg name="id" type="new_id" interface="mikros_timeline_v1"/>
      <arg name="timeline" type="fd"/>
    </request>

    <request name="get_surface_sync">
      <arg name="id" type="new_id" interface="mikros_surface_sync_v1"/>
      <arg name="surface" type="object" interface="wl_surface"/>
    </request>

    <event name="device">
      <arg name="name" type="string"/>
    </event>

    <event name="format">
      <arg name="format" type="uint"/>
      <arg name="modifier_hi" type="uint"/>
      <arg name="modifier_lo" type="uint"/>
    </event>

    <event name="done"/>

    <enum name="error">
      <entry name="invalid_buffer" value="0"/>
      <entry name="invalid_timeline" value="1"/>
      <entry name="surface_exists" value="2"/>
    </enum>
  </interface>

  <interface name="mikros_surface_sync_v1" version="1">
    <description summary="MIKSPEC-0076.R18"/>

    <request name="set_acquire_point">
      <arg name="timeline" type="object" interface="mikros_timeline_v1"/>
      <arg name="point_hi" type="uint"/>
      <arg name="point_lo" type="uint"/>
    </request>

    <request name="set_release_point">
      <arg name="timeline" type="object" interface="mikros_timeline_v1"/>
      <arg name="point_hi" type="uint"/>
      <arg name="point_lo" type="uint"/>
    </request>

    <request name="destroy" type="destructor"/>

    <enum name="error">
      <entry name="no_surface" value="0"/>
      <entry name="missing_point" value="1"/>
      <entry name="conflicting_points" value="2"/>
    </enum>
  </interface>

  <interface name="mikros_timeline_v1" version="1">
    <description summary="MIKSPEC-0076.R18"/>

    <request name="destroy" type="destructor"/>
  </interface>
</protocol>
